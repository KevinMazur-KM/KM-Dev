---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout noindex title="Page Not Found | Kevin Mazur" description="The requested page could not be found.">
  <section class="page-hero section-band narrow not-found">
    <p class="kicker">404</p>
    <h1>This path does not connect.</h1>
    <p>The page may have moved, or it may not exist yet.</p>
    <a class="button button-primary" href="/">Return Home <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
