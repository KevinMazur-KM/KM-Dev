---
import BaseLayout from "../layouts/BaseLayout.astro";

const metrics = [
  ["22+", "Years leading technology and transformation", "experience", "Career timeline"],
  ["10+", "Servers migrated to Azure, along with production storage", "vantage-point-title", "Vantage Point Title"],
];

const roles = [
  {
    id: "hcpa",
    title: "Manager Enterprise Technology",
    organization: "Hillsborough County Property Appraiser",
    location: "Tampa, Florida",
    dates: "2025 - Present",
    summary: "Leading enterprise technology across IT operations, GIS, web platforms, data, and emerging technology in a public-sector environment.",
    highlights: [
      "Direct digital transformation across public-facing property applications, internal operational systems, infrastructure planning, data integration, and service-management modernization.",
      "Launched a structured generative AI pilot for eight employees, including platform evaluation, onboarding, weekly feedback, adoption measurement, and executive reporting.",
      "Developing the organization’s AI policy and implementation roadmap around responsible use, security, governance, public-record obligations, training, and scalable adoption.",
      "Built Helix, an internal technology management platform, with AI assistance. Early use includes change records, and another team member extended the system with a Vendors and Contracts section.",
      "Partner with executive leadership, technology staff, vendors, and business stakeholders to prioritize projects and establish practices that support ongoing work.",
    ],
  },
  {
    id: "florida-land-design",
    title: "GIS and IT Manager",
    organization: "Florida Land Design and Permitting",
    location: "New Port Richey, Florida",
    dates: "2023 - 2025",
    summary: "Established the technology and GIS foundation for a growing land-development and engineering firm.",
    highlights: [
      "Aligned infrastructure, applications, data, security, and user support with business growth.",
      "Built SiteIQ with AI to analyze vacant land for development potential, using evaluation criteria provided to me.",
      "Built a system to track engineering permits from start to finish, including follow-up after issuance, helping staff focus on permits needing priority attention.",
    ],
  },
  {
    id: "vizionx",
    title: "President and Founder",
    organization: "VizionX",
    location: "Clearwater, Florida",
    dates: "2023 - 2024",
    summary: "Launched a technology startup, secured initial funding, and built a team of more than 25 employees and contractors across technology, operations, and business development.",
    highlights: [],
  },
  {
    id: "vantage-point-title",
    title: "Director of Information Technology",
    organization: "Vantage Point Title",
    location: "Clearwater, Florida",
    dates: "2012 - 2023",
    summary: "Served as senior technology executive through growth from 50 to more than 350 employees across seven locations.",
    highlights: [
      "Managed a $1 million annual technology budget, aligning investment with geographic expansion, risk management, and service delivery.",
      "Led robotic process automation in ResWare for repetitive tasks, including moving files between tasks, balancing files, and adding data extracted from documents. Learned the existing workflows, designed new workflows, worked with the vendor to build the bots, and led testing and implementation.",
      "Designed and managed the full Azure migration project, moving more than 10 servers and production storage.",
      "Established security, incident response, business continuity, and disaster recovery programs that exceeded the requirements of Fortune 50 banking clients.",
      "Led integrations with national lenders and banks, M&A technology due diligence, and vendor strategy.",
      "Helped secure SSAE 16 and ALTA Best Practices certifications, strengthening compliance maturity and competitive positioning.",
    ],
  },
  {
    id: "national-title-network",
    title: "Chief Information Officer",
    organization: "National Title Network",
    location: "Clearwater, Florida",
    dates: "2010 - 2012",
    summary: "Built and scaled technology operations from startup stage to support more than 300 employees nationwide within 18 months.",
    highlights: ["Improved workflows within the ResWare application."],
  },
  {
    id: "capstone-tropical",
    title: "IT Director",
    organization: "Capstone Tropical Holdings",
    location: "New Port Richey, Florida",
    dates: "2002 - 2008",
    summary: "Scaled technology from four to 16 offices across three counties, integrated acquired companies, and developed talent for leadership succession.",
    highlights: [],
  },
];

const capabilities: Array<[string, string[]]> = [
  ["Leadership and strategy", ["Enterprise technology leadership", "Product and platform strategy", "Cross-functional leadership", "Vendor evaluation and strategy", "Technology budgeting", "M&A technology due diligence"]],
  ["Transformation and operations", ["Digital transformation", "Team responsibilities and operating processes", "Change management", "Workflow design", "KPI and ROI definition", "Business continuity"]],
  ["AI and automation", ["AI enablement strategy", "Large language models", "Agentic workflows", "Responsible AI governance", "Automation and RPA", "Adoption and training"]],
  ["Platforms, data, and risk", ["Cloud and hybrid infrastructure", "Cybersecurity and compliance", "Data and GIS strategy", "Systems integration", "Incident response", "Regulated environments"]],
];
---

<BaseLayout title="About | Kevin Mazur" description="I lead enterprise technology in public service. My work spans IT operations, GIS, web platforms, data, and AI adoption.">
  <section class="resume-hero section-band">
    <div class="resume-hero-copy">
      <p class="eyebrow">About</p>
      <h1>Kevin Mazur</h1>
      <div class="resume-intro">
        <p>I lead enterprise technology in public service, with work spanning IT operations, GIS, web platforms, data, and AI adoption. Earlier roles took me through financial services, land development, healthcare, and growing technology organizations.</p>
        <p>Across those roles, I’ve worked on how systems fit together, how teams use them, and what it takes to keep them useful. This site is where I write about those decisions and what I’m learning as AI changes what I can build.</p>
      </div>
      <div class="resume-hero-actions">
        <a class="button button-primary" href="mailto:hello@kevinmazur.dev">Email Kevin <span aria-hidden="true">→</span></a>
        <a class="text-link" href="#experience">View Experience <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="resume-metrics" aria-label="Selected career outcomes">
    <div class="resume-metrics-inner section-band">
      {metrics.map(([value, label, anchor, context], index) => (
        <div class="resume-metric resume-reveal" style={`--resume-delay: ${index * 80}ms`}>
          <strong>{value}</strong><span>{label}</span>
          <a class="metric-context" href={`#${anchor}`}>{context}</a>
        </div>
      ))}
    </div>
  </section>

  <section id="experience" class="resume-experience section-band" aria-labelledby="experience-heading">
    <header class="resume-section-heading resume-reveal">
      <p class="eyebrow">Experience</p>
      <h2 id="experience-heading">A career spent building capacity.</h2>
      <p>The roles, responsibilities, and projects behind my work.</p>
    </header>
    <div class="career-timeline-wrap">
      <span class="career-line-progress" aria-hidden="true"></span>
      <ol class="career-timeline">
        {roles.map((role, index) => (
          <li id={role.id} class="resume-role resume-reveal" style={`--resume-delay: ${Math.min(index * 45, 180)}ms`}>
            <span class="career-marker" aria-hidden="true"></span>
            <article>
              <header class="role-header">
                <div><h3>{role.title}</h3><p class="role-organization">{role.organization}</p></div>
                <div class="role-meta"><strong>{role.dates}</strong><span>{role.location}</span></div>
              </header>
              <p class="role-summary">{role.summary}</p>
              {role.highlights.length > 0 && <ul>{role.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="resume-capabilities section-band" aria-labelledby="capabilities-heading">
    <header class="resume-section-heading resume-reveal">
      <p class="eyebrow">Capabilities</p>
      <h2 id="capabilities-heading">Broad enough to lead. Close enough to build.</h2>
    </header>
    <div class="capability-groups">
      {capabilities.map(([group, items], index) => (
        <section class="capability-group resume-reveal" style={`--resume-delay: ${index * 70}ms`}>
          <span class="capability-index" aria-hidden="true">0{index + 1}</span>
          <h3>{group}</h3>
          <ul>{items.map((item) => <li>{item}</li>)}</ul>
        </section>
      ))}
    </div>
  </section>

  <section class="resume-education section-band resume-reveal" aria-labelledby="education-heading">
    <div><p class="eyebrow">Education</p><h2 id="education-heading">Bachelor of Science</h2></div>
    <p>University of Miami</p>
  </section>

  <script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reducedMotion) {
      document.documentElement.classList.add("resume-motion");
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.14, rootMargin: "0px 0px -6%" });
      document.querySelectorAll(".resume-reveal").forEach((element) => revealObserver.observe(element));

      const timeline = document.querySelector<HTMLElement>(".career-timeline-wrap");
      let frameRequested = false;
      const updateTimeline = () => {
        if (!timeline) return;
        const rect = timeline.getBoundingClientRect();
        const start = window.innerHeight * 0.72;
        const distance = rect.height + window.innerHeight * 0.42;
        const progress = Math.min(1, Math.max(0, (start - rect.top) / distance));
        timeline.style.setProperty("--timeline-progress", String(progress));
        frameRequested = false;
      };
      window.addEventListener("scroll", () => {
        if (frameRequested) return;
        frameRequested = true;
        window.requestAnimationFrame(updateTimeline);
      }, { passive: true });
      updateTimeline();
    }
  </script>
</BaseLayout>
