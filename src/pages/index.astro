---
import BaseLayout from "../layouts/BaseLayout.astro";
import FocusIcon from "../components/FocusIcon.astro";
import PathHero from "../components/PathHero.astro";
import WritingCard from "../components/WritingCard.astro";
import type { CollectionEntry } from "astro:content";
import { getLatestWriting } from "../lib/content.js";

const writing = await getLatestWriting(3);
const focus = [
  ["strategy", "Technology Leadership", "Leading IT, GIS, data, web platforms, and emerging technology in public service."],
  ["automation", "Automation", "Introduced RPA that increased operational efficiency by 25% and shifted capacity to higher-value work."],
  ["ai", "AI Adoption", "Launched a structured generative AI pilot and am developing an AI policy and implementation roadmap."],
  ["people", "Technology at Scale", "Scaled technology through growth from 50 to more than 350 employees across seven locations."],
];
---

<BaseLayout>
  <section class="hero-section section-band">
    <div class="hero-copy reveal">
      <p class="kicker">Technology Leadership <span>/</span> AI <span>/</span> Automation</p>
      <h1>I make<br />emerging<br /><span class="hero-nowrap">technology</span><br /><span>useful.</span></h1>
      <p class="hero-lede">I lead enterprise technology in public service, build GIS and automation platforms, and guide responsible AI adoption.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/about/#experience">View My Experience <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="/writing/">Read My Writing</a>
      </div>
      <p class="hero-taxonomy">People <span>/</span> Systems <span>/</span> Ideas <span>/</span> Impact</p>
    </div>
    <div class="hero-art reveal" style="--delay: 120ms">
      <PathHero />
    </div>
  </section>

  <section class="focus-strip" aria-labelledby="focus-heading">
    <h2 id="focus-heading" class="sr-only">Areas of focus</h2>
    {focus.map(([type, title, text]) => (
      <article class="focus-item reveal">
        <FocusIcon type={type} />
        <h3>{title}</h3>
        <p>{text}</p>
        <a href="/about/" aria-label={`Learn more about ${title}`}>→</a>
      </article>
    ))}
  </section>

  <section class="writing-preview section-band" aria-labelledby="writing-heading">
    <div class="section-intro reveal">
      <p class="eyebrow">Latest Writing</p>
      <h2 id="writing-heading">Ideas for a more capable tomorrow.</h2>
      <p>Thoughts on AI, technology, leadership, and building systems that work in the real world.</p>
      <a class="text-link" href="/writing/">View All Writing <span aria-hidden="true">→</span></a>
    </div>
    <div class="card-grid">
      {writing.map((entry: CollectionEntry<"writing">) => <WritingCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
