---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkCard from "../../components/WorkCard.astro";
import { getPublishedWork } from "../../lib/content.js";

const work = await getPublishedWork();
---

<BaseLayout title="Work | Kevin Mazur" description="Selected work and field notes from Kevin Mazur on practical technology systems, automation, and transformation.">
  <section class="page-hero section-band narrow">
    <p class="kicker">Work</p>
    <h1>Evidence of practical technology leadership.</h1>
    <p>Case studies, builds, and field notes will live here as approved public material is added.</p>
  </section>
  <section class="index-grid section-band">
    {work.map((entry) => <WorkCard entry={entry} />)}
  </section>
</BaseLayout>
