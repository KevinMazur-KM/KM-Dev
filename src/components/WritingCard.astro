---
import PathGraphic from "./PathGraphic.astro";
import { formatDate } from "../lib/content.js";

const { entry, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel === "h2" ? "h2" : "h3";
---

<article class="content-card writing-card">
  <a href={`/writing/${entry.id}/`} aria-label={`Read ${entry.data.title}`}>
    <PathGraphic family={entry.data.visual.family} image={entry.data.visual.image} />
    <div class="card-body">
      <p class="card-meta">{formatDate(entry.data.date)}</p>
      <Heading>{entry.data.title}</Heading>
      <p>{entry.data.description}</p>
      <span class="arrow-link" aria-hidden="true">→</span>
    </div>
  </a>
</article>
