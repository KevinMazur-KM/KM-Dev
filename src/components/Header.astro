---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/writing/", label: "Writing" },
  { href: "/about/", label: "About" },
];

const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand-link" href="/" aria-label="Kevin Mazur dot dev home">
      <img src="/brand/kevinmazur-horizontal.svg" alt="Kevin Mazur .DEV" width="210" height="70" />
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <div class="social-links" aria-label="Social profiles">
        <a class="social-link" href="https://www.linkedin.com/in/kevin-mazur-6942131/" target="_blank" rel="me noreferrer" aria-label="Kevin Mazur on LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.4 8.1H3.2V20h3.2V8.1ZM4.8 3A1.9 1.9 0 1 0 4.8 6.8 1.9 1.9 0 0 0 4.8 3ZM20.8 13.2c0-3.6-1.9-5.3-4.5-5.3a4.4 4.4 0 0 0-4 2.2v-2H9.2V20h3.2v-5.9c0-1.6.3-3.1 2.3-3.1s2 1.8 2 3.2V20h3.2l.9-6.8Z" />
          </svg>
        </a>
        <a class="social-link" href="https://www.threads.com/@kevinmazur_dev" target="_blank" rel="me noreferrer" aria-label="Kevin Mazur on Threads">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.5 10.1c-.2-3.4-2.1-5.3-5.4-5.3-3.7 0-6 2.7-6 7.2s2.2 7.2 6 7.2c3 0 5.2-1.6 5.2-4.2 0-2.2-1.7-3.7-4.4-3.7-2.4 0-4 1.2-4 3 0 1.6 1.3 2.8 3.1 2.8 3.4 0 5.5-2.6 5.5-6.2 0-4.8-2-7.9-5.7-7.9C6.5 3 3.3 6.5 3.3 12s3.2 9 8.8 9c4.1 0 7.1-2.1 8-5.6" />
          </svg>
        </a>
      </div>
      <a class="button button-primary" href="mailto:hello@kevinmazur.dev">Let's Connect <span aria-hidden="true">→</span></a>
    </div>
  </div>
</header>
